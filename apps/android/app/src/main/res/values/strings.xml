    <!-- S1 Setup guide sheet -->
    <string name="setup_guide_title">Setup guide</string>
    <string name="setup_guide_subtitle">Follow these steps to connect your tablet to your Mac via USB</string>
    <string name="setup_step_1_title">Enable Developer options and USB debugging on this tablet</string>
    <string name="setup_step_1_body">Go to Android Settings &gt; About tablet &gt; tap Build number 7 times, then enable USB debugging in Developer options.</string>
    <string name="setup_step_2_title">Accept “Allow USB debugging?” on the tablet</string>
    <string name="setup_step_2_body">Tick “Always allow from this computer” for seamless zero-config reconnection when plugged in.</string>
    <string name="setup_step_3_title">Run wingpane on your Mac</string>
    <string name="setup_step_3_body">Start the desktop companion app or CLI daemon via Terminal or Spotlight.</string>
