    <string name="about_guide">Giới thiệu và hướng dẫn</string>
    <string name="about_title">Giới thiệu Wingpane</string>
    <string name="about_version_description">Version %1$s
Turn your Android tablet into a Mac secondary display, pen tablet and trackpad.
https://github.com/lamnt9/wingpane</string>
    <string name="about_display_title">Display</string>
    <string name="about_display_body">Your tablet is a second Mac screen. Touch works like a touchscreen; S Pen draws with pressure and tilt.</string>
    <string name="about_pen_title">Pen</string>
    <string name="about_pen_body">The tablet becomes a graphics tablet for your main display. Hover moves the cursor, the side button right-clicks. Video is paused to save battery.</string>
    <string name="about_trackpad_title">Trackpad</string>
    <string name="about_trackpad_body">One finger moves the cursor, tap clicks, two-finger tap right-clicks, two fingers scroll, tap-and-drag moves things. Three-finger swipe: Mission Control, App Exposé, switch Space. Pinch zooms.</string>
    <string name="about_keyboard_title">Keyboard</string>
    <string name="about_keyboard_body">Switch to Keyboard / Numpad for a MacBook-style layout. Tap a modifier once for the next key, twice to lock. IME types Vietnamese through your tablet keyboard.</string>
    <string name="about_mac_title">Mac setup</string>
    <string name="about_mac_body">On the Mac enable Screen Recording and Accessibility for Wingpane and wingpaned (menu bar → Permissions). Without Accessibility the Mac ignores the pen, trackpad and keyboard.</string>
    <string name="about_hud_title">HUD</string>
    <string name="about_hud_body">Tap the pill at the top of the stream to switch modes, adjust pen pressure, palm rejection and disconnect.</string>
